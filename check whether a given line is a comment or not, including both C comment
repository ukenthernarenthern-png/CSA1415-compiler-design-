#include <stdio.h>
#include <string.h>

int main()
{
    char line[500];
    int len, i;
    int single = 0, multi = 0;

    printf("Enter a line:\n");
    fgets(line, sizeof(line), stdin);

    len = strlen(line);

    for (i = 0; i < len; i++)
    {
        /* Check for single-line comment */
        if (line[i] == '/' && line[i + 1] == '/')
        {
            single = 1;
            break;
        }

        /* Check for multi-line comment */
        if (line[i] == '/' && line[i + 1] == '*')
        {
            multi = 1;
            break;
        }
    }

    if (single)
    {
        printf("The given line is a single-line comment.\n");
    }
    else if (multi)
    {
        /* Check whether closing */ exists */
        for (i = i + 2; i < len - 1; i++)
        {
            if (line[i] == '*' && line[i + 1] == '/')
            {
                printf("The given line is a multi-line comment.\n");
                return 0;
            }
        }

        printf("The given line starts a multi-line comment.\n");
    }
    else
    {
        printf("The given line is not a comment.\n");
    }

    return 0;
}
