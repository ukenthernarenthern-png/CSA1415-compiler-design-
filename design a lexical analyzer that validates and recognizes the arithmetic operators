#include <stdio.h>

int main()
{
    char input[100];
    int i = 0;

    printf("Enter an expression: ");
    fgets(input, sizeof(input), stdin);

    printf("\nOperators found:\n");

    while (input[i] != '\0')
    {
        if (input[i] == '+')
            printf("+ : Addition Operator\n");

        else if (input[i] == '-')
            printf("- : Subtraction Operator\n");

        else if (input[i] == '*')
            printf("* : Multiplication Operator\n");

        else if (input[i] == '/')
            printf("/ : Division Operator\n");

        i++;
    }

    return 0;
}
