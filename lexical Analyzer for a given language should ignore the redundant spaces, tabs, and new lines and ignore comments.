#include <stdio.h>
#include <ctype.h>
#include <string.h>

int isKeyword(char word[])
{
    char *keywords[] = {
        "int", "float", "char", "double",
        "if", "else", "while", "for", "return"
    };

    int i;

    for (i = 0; i < 9; i++)
    {
        if (strcmp(word, keywords[i]) == 0)
            return 1;
    }

    return 0;
}

int main()
{
    char input[1000];
    int i = 0;

    printf("Enter the source code:\n");
    fgets(input, sizeof(input), stdin);

    while (input[i] != '\0')
    {
        /* Ignore spaces, tabs and new lines */
        if (isspace(input[i]))
        {
            i++;
            continue;
        }

        /* Ignore single-line comments */
        if (input[i] == '/' && input[i + 1] == '/')
        {
            break;
        }

        /* Ignore multi-line comments */
        if (input[i] == '/' && input[i + 1] == '*')
        {
            i += 2;

            while (input[i] != '\0')
            {
                if (input[i] == '*' && input[i + 1] == '/')
                {
                    i += 2;
                    break;
                }
                i++;
            }

            continue;
        }

        /* Identify identifiers and keywords */
        if (isalpha(input[i]) || input[i] == '_')
        {
            char word[50];
            int j = 0;

            while (isalnum(input[i]) || input[i] == '_')
            {
                if (j < 49)
                    word[j++] = input[i];

                i++;
            }

            word[j] = '\0';

            if (isKeyword(word))
                printf("%s : Keyword\n", word);
            else
                printf("%s : Identifier\n", word);

            continue;
        }

        /* Identify constants */
        if (isdigit(input[i]))
        {
            char num[50];
            int j = 0;

            while (isdigit(input[i]) || input[i] == '.')
            {
                if (j < 49)
                    num[j++] = input[i];

                i++;
            }

            num[j] = '\0';

            printf("%s : Constant\n", num);
            continue;
        }

        /* Identify operators */
        if (input[i] == '+' || input[i] == '-' ||
            input[i] == '*' || input[i] == '/' ||
            input[i] == '%' || input[i] == '=' ||
            input[i] == '<' || input[i] == '>')
        {
            printf("%c : Operator\n", input[i]);
            i++;
            continue;
        }

        i++;
    }

    return 0;
}
