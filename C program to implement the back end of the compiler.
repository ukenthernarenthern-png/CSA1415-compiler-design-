#include <stdio.h>
#include <string.h>

int main()
{
    int n, i;
    char op1[20], op2[20], result[20], op[5];

    printf("Enter number of three address code statements: ");
    scanf("%d", &n);

    printf("Enter three address code:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%s = %s %s %s", result, op1, op, op2);

        printf("\nMOV R0, %s", op1);

        if (strcmp(op, "+") == 0)
            printf("\nADD R0, %s", op2);

        else if (strcmp(op, "-") == 0)
            printf("\nSUB R0, %s", op2);

        else if (strcmp(op, "*") == 0)
            printf("\nMUL R0, %s", op2);

        else if (strcmp(op, "/") == 0)
            printf("\nDIV R0, %s", op2);

        printf("\nMOV %s, R0\n", result);
    }

    return 0;
}
